# From @BotFather — required for real Telegram initData verification.
# Local dev works without it (verification is skipped with a warning) but
# NEVER deploy without this set.
BOT_TOKEN=

# Shared secret for the admin panel — change this before deploying anywhere.
ADMIN_TOKEN=change-me-local-dev-only

PORT=4000

# Shared secret Monetag would send with its S2S postback — not enforced yet,
# see backend/src/routes/monetag.ts.
MONETAG_POSTBACK_SECRET=change-me
